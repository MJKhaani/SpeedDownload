{
  "manifest_version": 3,
  "name": "Speed Download",
  "version": "0.3.0",
  "description": "Review single downloads, selected page links, and torrents in the Speed Download app.",
  "permissions": [
    "contextMenus",
    "nativeMessaging",
    "activeTab",
    "scripting",
    "downloads",
    "storage",
    "tabs",
    "webRequest"
  ],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Speed Download",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "key": "",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
