{
  "manifest_version": 3,
  "name": "Speed Download",
  "version": "0.1.0",
  "description": "Send selected links and optional browser downloads to Speed Download.",
  "permissions": ["contextMenus", "nativeMessaging", "activeTab", "scripting", "downloads", "storage"],
  "background": { "scripts": ["background.js"] },
  "action": { "default_title": "Speed Download", "default_popup": "popup.html" },
  "browser_specific_settings": {
    "gecko": {
      "id": "speed-download@mjkhaani.github",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
