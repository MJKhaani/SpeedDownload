<Window x:Class="SpeedDownload.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Speed Download" Icon="SpeedDownload.ico" Width="1100" Height="700"
        MinWidth="800" MinHeight="480" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Padding="16,12" BorderBrush="#33000000" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Speed Download" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,18,0" />
                    <Button Content="+" Width="34" Height="30" FontSize="18" ToolTip="Add download" Click="OnAdd" />
                    <Button Content="Refresh" Height="30" Margin="8,0,0,0" Click="OnRefresh" />
                </StackPanel>
                <TextBox x:Name="SearchBox" DockPanel.Dock="Right" Width="230" Height="30"
                         VerticalContentAlignment="Center" ToolTip="Filter downloads" TextChanged="OnSearchChanged" />
            </DockPanel>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="InspectorColumn" Width="0" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#F3F4F6" BorderBrush="#33000000" BorderThickness="0,0,1,0" Padding="8,12">
                <ListBox x:Name="Navigation" SelectionChanged="OnNavigationChanged" BorderThickness="0" Background="Transparent">
                    <ListBoxItem Content="All Downloads" IsSelected="True" />
                    <ListBoxItem Content="Unfinished" />
                    <ListBoxItem Content="Completed" />
                    <ListBoxItem Content="Failed" />
                </ListBox>
            </Border>
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="18,16,18,10">
                    <TextBlock x:Name="SectionTitle" Text="All Downloads" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock x:Name="SectionCount" Foreground="Gray" FontSize="11" />
                </StackPanel>
                <ListView x:Name="JobsList" Grid.Row="1" SelectionChanged="OnJobSelectionChanged"
                          BorderThickness="0" Margin="8,0,8,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="8" BorderBrush="#22000000" BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Host}" Foreground="Gray" FontSize="11" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding State}" FontSize="11" />
                                        <ProgressBar Value="{Binding Progress}" Maximum="100" Height="4" Margin="0,4,0,4" />
                                        <TextBlock Text="{Binding ProgressText}" Foreground="Gray" FontSize="10" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="▶" Tag="{Binding JobId}" ToolTip="Start or resume" Click="OnStartOrResume" Width="28" Height="28" />
                                        <Button Content="Ⅱ" Tag="{Binding JobId}" ToolTip="Pause" Click="OnPause" Width="28" Height="28" Margin="4,0,0,0" />
                                        <Button Content="ⓘ" Tag="{Binding JobId}" ToolTip="Show details" Click="OnInfo" Width="28" Height="28" Margin="4,0,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
            <Border x:Name="Inspector" Grid.Column="2" Visibility="Collapsed" BorderBrush="#33000000" BorderThickness="1,0,0,0" Padding="14">
                <StackPanel>
                    <DockPanel>
                        <TextBlock Text="Details" FontSize="16" FontWeight="SemiBold" DockPanel.Dock="Left" />
                        <Button Content="×" DockPanel.Dock="Right" ToolTip="Close details" Click="OnCloseInspector" />
                    </DockPanel>
                    <TextBlock x:Name="DetailTitle" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,18,0,10" />
                    <TextBlock Text="Status" FontWeight="SemiBold" />
                    <TextBlock x:Name="DetailState" Margin="0,2,0,12" />
                    <TextBlock Text="Source" FontWeight="SemiBold" />
                    <TextBlock x:Name="DetailUrl" TextWrapping="Wrap" Margin="0,2,0,12" />
                    <TextBlock Text="Destination" FontWeight="SemiBold" />
                    <TextBlock x:Name="DetailDestination" TextWrapping="Wrap" Margin="0,2,0,12" />
                    <TextBlock Text="Progress" FontWeight="SemiBold" />
                    <TextBlock x:Name="DetailProgress" Margin="0,2,0,12" />
                    <TextBlock x:Name="DetailError" TextWrapping="Wrap" Foreground="Firebrick" />
                </StackPanel>
            </Border>
        </Grid>
        <Border Grid.Row="2" Padding="12,7" Background="#F3F4F6" BorderBrush="#33000000" BorderThickness="0,1,0,0">
            <DockPanel>
                <TextBlock x:Name="ConnectionStatus" Text="Connecting to local engine…" DockPanel.Dock="Left" />
                <TextBlock x:Name="QueueSummary" DockPanel.Dock="Right" Text="0 active · 0 queued" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
