<Window x:Class="SpeedDownload.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Speed Download" Icon="SpeedDownload.ico" Width="1160" Height="740"
        MinWidth="840" MinHeight="500" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="13" Background="#F8FAFC">
    <Window.Resources>
        <Style x:Key="CommandButton" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#EAF3FC" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#D6EAFB" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource CommandButton}">
            <Setter Property="Background" Value="#0067C0" />
            <Setter Property="BorderBrush" Value="#0067C0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#005A9E" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#004578" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RowButton" TargetType="Button" BasedOn="{StaticResource CommandButton}">
            <Setter Property="Width" Value="30" /><Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" /><Setter Property="Background" Value="White" />
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12,9" /><Setter Property="Margin" Value="0,2" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30" /><RowDefinition Height="58" />
            <RowDefinition Height="*" /><RowDefinition Height="36" />
        </Grid.RowDefinitions>
        <Menu Grid.Row="0" Background="#F3F5F8" BorderBrush="#D8DFE7" BorderThickness="0,0,0,1">
            <MenuItem Header="_File">
                <MenuItem Header="_New download…" InputGestureText="Ctrl+N" Click="OnAdd" />
                <MenuItem Header="Open _Downloads folder" Click="OnOpenDownloadsFolder" />
                <Separator /><MenuItem Header="E_xit" Click="OnQuit" />
            </MenuItem>
            <MenuItem Header="_Downloads">
                <MenuItem Header="_Start or resume selected" Click="OnStartSelected" />
                <MenuItem Header="_Pause selected" Click="OnPauseSelected" />
                <Separator /><MenuItem Header="_Refresh" InputGestureText="F5" Click="OnRefresh" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="_Show or hide details" Click="OnToggleInspector" />
                <MenuItem Header="_Find downloads" InputGestureText="Ctrl+F" Click="OnFind" />
            </MenuItem>
            <MenuItem Header="_Tools"><MenuItem Header="Set _global speed limit…" Click="OnFocusSpeedLimit" /></MenuItem>
            <MenuItem Header="_Help"><MenuItem Header="_About Speed Download" Click="OnAbout" /></MenuItem>
        </Menu>
        <Border Grid.Row="1" Background="White" BorderBrush="#D8DFE7" BorderThickness="0,0,0,1" Padding="18,10">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="+  New download" Style="{StaticResource PrimaryButton}" Click="OnAdd" />
                    <Button Content="▶  Resume" Style="{StaticResource CommandButton}" Margin="8,0,0,0" Click="OnStartSelected" />
                    <Button Content="Ⅱ  Pause" Style="{StaticResource CommandButton}" Margin="8,0,0,0" Click="OnPauseSelected" />
                    <Button Content="↻  Refresh" Style="{StaticResource CommandButton}" Margin="8,0,0,0" Click="OnRefresh" />
                </StackPanel>
                <Border DockPanel.Dock="Right" Width="236" Height="32" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4">
                    <DockPanel>
                        <TextBlock Text="⌕" FontSize="19" Foreground="#64748B" VerticalAlignment="Center" Margin="9,0,6,0" />
                        <TextBox x:Name="SearchBox" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center"
                                 ToolTip="Find downloads (Ctrl+F)" TextChanged="OnSearchChanged" />
                    </DockPanel>
                </Border>
            </DockPanel>
        </Border>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190" /><ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="InspectorColumn" Width="0" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#F1F5F9" BorderBrush="#D8DFE7" BorderThickness="0,0,1,0" Padding="10,16">
                <StackPanel>
                    <TextBlock Text="LIBRARY" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" Margin="11,0,0,8" />
                    <ListBox x:Name="Navigation" SelectionChanged="OnNavigationChanged" BorderThickness="0" Background="Transparent">
                        <ListBoxItem Content="All Downloads" IsSelected="True" /><ListBoxItem Content="Unfinished" />
                        <ListBoxItem Content="Completed" /><ListBoxItem Content="Failed" />
                    </ListBox>
                </StackPanel>
            </Border>
            <Grid Grid.Column="1">
                <Grid.RowDefinitions><RowDefinition Height="74" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="20,12">
                    <StackPanel>
                        <TextBlock x:Name="SectionTitle" Text="All Downloads" FontSize="20" FontWeight="SemiBold" Foreground="#1F2937" />
                        <TextBlock x:Name="SectionCount" Foreground="#64748B" FontSize="11" Margin="0,3,0,0" />
                    </StackPanel>
                </Border>
                <ListView x:Name="JobsList" Grid.Row="1" SelectionChanged="OnJobSelectionChanged"
                          BorderThickness="0" Background="#F8FAFC" Padding="10,8" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Margin" Value="0,0,0,5" /><Setter Property="Padding" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" BorderBrush="#DFE5EC" BorderThickness="1" CornerRadius="6" Padding="12,9">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="38" /><ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="205" /><ColumnDefinition Width="104" />
                                    </Grid.ColumnDefinitions>
                                    <Image Grid.Column="0" Source="{Binding FileIcon}" Width="24" Height="24" VerticalAlignment="Center" HorizontalAlignment="Left" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="#1F2937" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Host}" Foreground="#64748B" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <DockPanel LastChildFill="False">
                                            <TextBlock Text="{Binding State}" Foreground="#475569" FontSize="11" DockPanel.Dock="Left" />
                                            <TextBlock Text="{Binding SpeedText}" Foreground="#475569" FontSize="11" DockPanel.Dock="Right" />
                                        </DockPanel>
                                        <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" Height="5" Margin="0,6,0,4" />
                                        <TextBlock Text="{Binding ProgressText}" Foreground="#64748B" FontSize="10" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <Button Content="▶" Tag="{Binding JobId}" ToolTip="Start or resume" Click="OnStartOrResume" Style="{StaticResource RowButton}" />
                                        <Button Content="Ⅱ" Tag="{Binding JobId}" ToolTip="Pause" Click="OnPause" Style="{StaticResource RowButton}" Margin="3,0,0,0" />
                                        <Button Content="ⓘ" Tag="{Binding JobId}" ToolTip="Show details" Click="OnInfo" Style="{StaticResource RowButton}" Margin="3,0,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
            <Border x:Name="Inspector" Grid.Column="2" Visibility="Collapsed" Background="White" BorderBrush="#D8DFE7" BorderThickness="1,0,0,0" Padding="16,14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock Text="Transfer details" FontSize="16" FontWeight="SemiBold" Foreground="#1F2937" VerticalAlignment="Center" DockPanel.Dock="Left" />
                            <Button Content="×" DockPanel.Dock="Right" ToolTip="Close details" Click="OnCloseInspector" Style="{StaticResource RowButton}" />
                        </DockPanel>
                        <TextBlock x:Name="DetailTitle" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,18,0,16" />
                        <TextBlock Text="Status" FontSize="11" Foreground="#64748B" /><TextBlock x:Name="DetailState" Margin="0,3,0,14" />
                        <TextBlock Text="Source" FontSize="11" Foreground="#64748B" /><TextBlock x:Name="DetailUrl" TextWrapping="Wrap" Margin="0,3,0,14" />
                        <TextBlock Text="Destination" FontSize="11" Foreground="#64748B" /><TextBlock x:Name="DetailDestination" TextWrapping="Wrap" Margin="0,3,0,14" />
                        <TextBlock Text="Progress" FontSize="11" Foreground="#64748B" /><TextBlock x:Name="DetailProgress" Margin="0,3,0,14" />
                        <TextBlock x:Name="DetailError" TextWrapping="Wrap" Foreground="Firebrick" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <Border Grid.Row="3" Background="#F1F5F9" BorderBrush="#D8DFE7" BorderThickness="0,1,0,0" Padding="14,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="ConnectionDot" Width="7" Height="7" Fill="#F59E0B" Margin="0,0,8,0" />
                    <TextBlock x:Name="ConnectionStatus" Text="Connecting to local engine…" Foreground="#475569" FontSize="11" />
                </StackPanel>
                <TextBlock x:Name="TotalSpeed" Grid.Column="1" Text="↓ 0 KB/s" Foreground="#334155" FontSize="11" VerticalAlignment="Center" Margin="0,0,18,0" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,0">
                    <TextBlock Text="Global limit" Foreground="#475569" FontSize="11" VerticalAlignment="Center" Margin="0,0,7,0" />
                    <ComboBox x:Name="StatusLimitCombo" Width="118" Height="26" FontSize="11" DisplayMemberPath="Label"
                              ToolTip="Global download speed limit" SelectionChanged="OnSpeedLimitChanged" />
                </StackPanel>
                <TextBlock x:Name="QueueSummary" Grid.Column="3" Text="0 active · 0 queued" Foreground="#64748B" FontSize="11" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
