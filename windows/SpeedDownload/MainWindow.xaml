<Window
    x:Class="SpeedDownload.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Speed Download">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid x:Name="AppTitleBar" Height="40"><TextBlock Text="Speed Download" /></Grid>
        <NavigationView x:Name="AppNavigation" Grid.Row="1" IsBackButtonVisible="Collapsed" ItemInvoked="OnNavigationItemInvoked">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="AllNavigationItem" Content="All downloads" Tag="All downloads" IsSelected="True" />
                <NavigationViewItem x:Name="ProgressNavigationItem" Content="In progress" Tag="In progress" />
                <NavigationViewItem x:Name="CompletedNavigationItem" Content="Completed" Tag="Completed" />
                <NavigationViewItem x:Name="FailedNavigationItem" Content="Failed" Tag="Failed" />
            </NavigationView.MenuItems>
            <Grid>
                <Grid x:Name="Workspace">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="SectionTitle" Text="All downloads" />
                        <AutoSuggestBox x:Name="SearchBox" TextChanged="OnSearchTextChanged" />
                        <InfoBar x:Name="MessageBar" IsOpen="False" />
                    </StackPanel>
                    <Grid Grid.Row="1" SizeChanged="OnWorkspaceSizeChanged">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="DetailsColumn" Width="340"/></Grid.ColumnDefinitions>
                        <ListView x:Name="JobsList" SelectionChanged="OnJobSelectionChanged" />
                        <Border x:Name="DetailsPane" Grid.Column="1">
                            <StackPanel>
                                <Button x:Name="CloseDetailsButton" Content="Back" Click="OnCloseDetails" />
                                <TextBlock x:Name="DetailTitle" />
                                <TextBlock x:Name="DetailState" />
                                <TextBlock x:Name="DetailUrl" />
                                <TextBlock x:Name="DetailDestination" />
                                <TextBlock x:Name="DetailProgress" />
                                <TextBlock x:Name="DetailError" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <StackPanel Grid.Row="2">
                        <TextBlock x:Name="ConnectionStatus" />
                        <TextBlock x:Name="QueueSummary" />
                    </StackPanel>
                </Grid>
                <ScrollViewer x:Name="SettingsView" Visibility="Collapsed">
                    <StackPanel>
                        <InfoBar x:Name="SettingsMessage" />
                        <ToggleSwitch x:Name="DebugLoggingSwitch" Toggled="OnSettingToggled" />
                        <TextBox x:Name="DownloadFolderBox" LostFocus="OnSettingLostFocus" />
                        <NumberBox x:Name="ConcurrentBox" ValueChanged="OnNumberSettingChanged" />
                        <NumberBox x:Name="ConnectionsBox" ValueChanged="OnNumberSettingChanged" />
                        <ComboBox x:Name="MultipartModeBox" SelectionChanged="OnChoiceSettingChanged" />
                        <ComboBox x:Name="ProxyModeBox" SelectionChanged="OnChoiceSettingChanged" />
                        <TextBox x:Name="ProxyUrlBox" LostFocus="OnSettingLostFocus" />
                        <NumberBox x:Name="BandwidthBox" ValueChanged="OnNumberSettingChanged" />
                        <TextBox x:Name="BrowserExtensionsBox" LostFocus="OnSettingLostFocus" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
