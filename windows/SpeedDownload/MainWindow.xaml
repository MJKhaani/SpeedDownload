<Window
    x:Class="SpeedDownload.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SpeedDownload"
    Title="Speed Download">
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Padding="24,18" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="3">
                <TextBlock Text="Speed Download" Style="{ThemeResource TitleTextBlockStyle}" />
                <TextBlock Text="Your downloads, in one place." Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <Button Grid.Column="1" Content="Refresh" Click="OnRefresh" />
            <Button Grid.Column="2" Content="Add Download" Style="{ThemeResource AccentButtonStyle}" Click="OnAddDownload" />
        </Grid>
        <TextBlock x:Name="ConnectionStatus" Grid.Row="1" Margin="24,0" Text="Connecting to engine…" />
        <InfoBar x:Name="MessageBar" Grid.Row="2" Margin="24,12,24,0" IsOpen="False" Severity="Informational" />
        <ScrollViewer Grid.Row="3" Padding="24" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="JobsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:DownloadJob">
                        <Border Margin="0,0,0,12" Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12">
                            <StackPanel Spacing="8">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Title}" Style="{ThemeResource SubtitleTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind State}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                                <TextBlock Text="{x:Bind Url}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                <ProgressBar Value="{x:Bind Progress}" Maximum="100" Visibility="{x:Bind ProgressVisibility}" />
                                <TextBlock Text="{x:Bind ProgressText}" Visibility="{x:Bind ProgressVisibility}" FontSize="12" />
                                <TextBlock Text="{x:Bind ErrorMessage}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind Destination}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" FontSize="12" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Start" Tag="{x:Bind JobId}" Visibility="{x:Bind StartVisibility}" Click="OnJobAction" />
                                    <Button Content="Pause" Tag="{x:Bind JobId}" Visibility="{x:Bind PauseVisibility}" Click="OnJobAction" />
                                    <Button Content="Resume" Tag="{x:Bind JobId}" Visibility="{x:Bind ResumeVisibility}" Click="OnJobAction" />
                                    <Button Content="Retry" Tag="{x:Bind JobId}" Visibility="{x:Bind RetryVisibility}" Click="OnJobAction" />
                                    <Button Content="Cancel" Tag="{x:Bind JobId}" Visibility="{x:Bind CancelVisibility}" Click="OnJobAction" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>
