<Window
    x:Class="SpeedDownload.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SpeedDownload"
    Title="Speed Download">
    <Window.SystemBackdrop><MicaBackdrop /></Window.SystemBackdrop>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TitleBar x:Name="AppTitleBar" Title="Speed Download" />
    <NavigationView x:Name="AppNavigation" Grid.Row="1" IsBackButtonVisible="Collapsed" PaneDisplayMode="LeftMinimal" IsPaneOpen="False" OpenPaneLength="230" IsSettingsVisible="True" ItemInvoked="OnNavigationItemInvoked">
        <NavigationView.MenuItems>
            <NavigationViewItem x:Name="AllNavigationItem" Content="All downloads" Tag="All downloads" Icon="Download" IsSelected="True" />
            <NavigationViewItem x:Name="ProgressNavigationItem" Content="In progress" Tag="In progress" Icon="Play" />
            <NavigationViewItem x:Name="CompletedNavigationItem" Content="Completed" Tag="Completed" Icon="Accept" />
            <NavigationViewItem x:Name="FailedNavigationItem" Content="Failed" Tag="Failed" Icon="Important" />
            <NavigationViewItemSeparator />
            <NavigationViewItemHeader Content="Queues" />
            <NavigationViewItem Content="New queue" Tag="new-queue" Icon="Add" />
        </NavigationView.MenuItems>
        <Grid>
        <Grid x:Name="Workspace" Padding="16,12,20,16" RowSpacing="12">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Spacing="8">
                <TextBlock x:Name="SectionTitle" Text="All downloads" Style="{ThemeResource TitleTextBlockStyle}" />
                <CommandBar DefaultLabelPosition="Right">
                    <AppBarButton Label="Add download" Icon="Add" Click="OnAddDownload" />
                    <AppBarButton Label="Start all" Icon="Play" Click="OnStartAll" />
                    <AppBarButton Label="Pause all" Icon="Pause" Click="OnPauseAll" />
                    <CommandBar.Content><AutoSuggestBox x:Name="SearchBox" Width="260" PlaceholderText="Search downloads" QueryIcon="Find" TextChanged="OnSearchTextChanged" /></CommandBar.Content>
                    <CommandBar.SecondaryCommands><AppBarButton Label="Refresh" Icon="Refresh" Click="OnRefresh" /><AppBarButton Label="Queue settings" Icon="Setting" Click="OnQueueSettings" /></CommandBar.SecondaryCommands>
                </CommandBar>
                <InfoBar x:Name="MessageBar" IsOpen="False" Severity="Informational" />
            </StackPanel>
            <Grid Grid.Row="1" ColumnSpacing="14" SizeChanged="OnWorkspaceSizeChanged">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="DetailsColumn" Width="0"/></Grid.ColumnDefinitions>
                <ListView x:Name="JobsList" SelectionMode="Single" SelectionChanged="OnJobSelectionChanged" IsItemClickEnabled="False">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:DownloadJob">
                            <Grid Padding="12" ColumnSpacing="12" MinHeight="72">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="160"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Spacing="5" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Title}" Style="{ThemeResource SubtitleTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Host}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" FontSize="12" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind State}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <ProgressBar Value="{x:Bind Progress}" Maximum="100" Visibility="{x:Bind ProgressVisibility}" />
                                    <TextBlock Text="{x:Bind ProgressText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="11" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <Button Content="{x:Bind PrimaryActionText}" Tag="{x:Bind JobId}" Visibility="{x:Bind PrimaryActionVisibility}" Click="OnJobAction" />
                                    <Button Content="ⓘ" Tag="{x:Bind JobId}" Click="OnShowDetails" ToolTipService.ToolTip="Show transfer details" />
                                    <Button Content="⋯" Tag="{x:Bind JobId}" Click="OnMoreActions" ToolTipService.ToolTip="More actions" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <Border x:Name="DetailsPane" Grid.Column="1" Visibility="Collapsed" Padding="18" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="14">
                            <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Transfer details" Style="{ThemeResource TitleTextBlockStyle}" /><Button x:Name="CloseDetailsButton" Content="Close" Click="OnCloseDetails" /></StackPanel>
                            <TextBlock x:Name="DetailTitle" Text="Select a transfer" Style="{ThemeResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                            <TextBlock Text="STATUS" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="DetailState" Text="—" />
                            <TextBlock Text="SOURCE" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="DetailUrl" Text="—" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                            <TextBlock Text="DESTINATION" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="DetailDestination" Text="—" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                            <TextBlock x:Name="DetailProgress" Text="" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="DetailError" Text="" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
            <Grid Grid.Row="2" ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="ConnectionStatus" Text="Starting local engine…" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                <ComboBox x:Name="SpeedLimitBox" Grid.Column="1" Header="Speed limit" MinWidth="125" SelectionChanged="OnSpeedLimitChanged"><ComboBoxItem Content="Unlimited" Tag="0"/><ComboBoxItem Content="1 MB/s" Tag="1"/><ComboBoxItem Content="2 MB/s" Tag="2"/><ComboBoxItem Content="5 MB/s" Tag="5"/><ComboBoxItem Content="10 MB/s" Tag="10"/><ComboBoxItem Content="20 MB/s" Tag="20"/><ComboBoxItem Content="50 MB/s" Tag="50"/><ComboBoxItem Content="100 MB/s" Tag="100"/></ComboBox>
                <TextBlock x:Name="QueueSummary" Grid.Column="2" Text="0 active · 0 queued" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
            </Grid>
        </Grid>
        <ScrollViewer x:Name="SettingsView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="16" Spacing="14" HorizontalAlignment="Stretch">
                <TextBlock Text="Settings" Style="{ThemeResource TitleTextBlockStyle}" />
                <InfoBar x:Name="SettingsMessage" IsOpen="False" Severity="Error" />
                <TextBlock Text="General" Style="{ThemeResource SubtitleTextBlockStyle}" />
                <StackPanel Spacing="8"><TextBlock Text="Diagnostic logging"/><ToggleSwitch x:Name="DebugLoggingSwitch" Toggled="OnSettingToggled"/><TextBlock Text="Writes redacted engine activity to a bounded local log." Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
                <TextBlock Text="Downloads" Style="{ThemeResource SubtitleTextBlockStyle}" Margin="0,12,0,0" />
                <TextBox x:Name="DownloadFolderBox" Header="Default download folder" LostFocus="OnSettingLostFocus" />
                <NumberBox x:Name="ConcurrentBox" Header="Maximum simultaneous downloads" Minimum="1" Maximum="32" SpinButtonPlacementMode="Compact" ValueChanged="OnNumberSettingChanged" />
                <TextBlock Text="Network" Style="{ThemeResource SubtitleTextBlockStyle}" Margin="0,12,0,0" />
                <NumberBox x:Name="ConnectionsBox" Header="Maximum connections per download" Minimum="1" Maximum="32" SpinButtonPlacementMode="Compact" ValueChanged="OnNumberSettingChanged" />
                <ComboBox x:Name="MultipartModeBox" Header="Parallel downloading" SelectionChanged="OnChoiceSettingChanged"><ComboBoxItem Content="Automatic" Tag="auto"/><ComboBoxItem Content="Fixed" Tag="fixed"/><ComboBoxItem Content="Off" Tag="off"/></ComboBox>
                <ComboBox x:Name="ProxyModeBox" Header="Proxy mode" SelectionChanged="OnChoiceSettingChanged"><ComboBoxItem Content="System" Tag="system"/><ComboBoxItem Content="Manual HTTP" Tag="custom"/><ComboBoxItem Content="Disabled" Tag="disabled"/></ComboBox>
                <TextBox x:Name="ProxyUrlBox" Header="Manual HTTP proxy URL" PlaceholderText="http://proxy.example.com:8080" LostFocus="OnSettingLostFocus" />
                <TextBlock Text="Bandwidth" Style="{ThemeResource SubtitleTextBlockStyle}" Margin="0,12,0,0" />
                <NumberBox x:Name="BandwidthBox" Header="Global download limit (MB/s; 0 = unlimited)" Minimum="0" Maximum="100000" SpinButtonPlacementMode="Compact" ValueChanged="OnNumberSettingChanged" />
                <TextBlock Text="Integration" Style="{ThemeResource SubtitleTextBlockStyle}" Margin="0,12,0,0" />
                <TextBox x:Name="BrowserExtensionsBox" Header="Browser capture file extensions" LostFocus="OnSettingLostFocus" />
                <TextBlock Text="Torrent seeding is not active in the engine yet." Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </ScrollViewer>
        </Grid>
    </NavigationView>
    </Grid>
</Window>
