<Window
    x:Class="SpeedDownload.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SpeedDownload"
    Title="Speed Download">
    <Window.SystemBackdrop><MicaBackdrop /></Window.SystemBackdrop>
    <Grid>
        <Grid.Resources>
            <DataTemplate x:Key="TorrentFileTemplate">
                <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{Binding Path}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding SizeText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </CheckBox>
            </DataTemplate>
        </Grid.Resources>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TitleBar x:Name="AppTitleBar" Title="Speed Download" />
    <NavigationView x:Name="AppNavigation" Grid.Row="1" IsBackButtonVisible="Collapsed" PaneDisplayMode="Auto" OpenPaneLength="230" IsSettingsVisible="True" ItemInvoked="OnNavigationItemInvoked">
        <NavigationView.MenuItems>
            <NavigationViewItem x:Name="AllNavigationItem" Content="All downloads" Tag="All downloads" Icon="Download" IsSelected="True" />
            <NavigationViewItem x:Name="ProgressNavigationItem" Content="In progress" Tag="In progress" Icon="Play" />
            <NavigationViewItem x:Name="CompletedNavigationItem" Content="Completed" Tag="Completed" Icon="Accept" />
            <NavigationViewItem x:Name="FailedNavigationItem" Content="Failed" Tag="Failed" Icon="Important" />
            <NavigationViewItemSeparator />
            <NavigationViewItemHeader Content="Queues" />
            <NavigationViewItem Content="New queue" Tag="new-queue" Icon="Add" />
        </NavigationView.MenuItems>
        <NavigationView.FooterMenuItems>
            <NavigationViewItem x:Name="EngineStatusItem" Content="Starting engine…" IsEnabled="False">
                <NavigationViewItem.Icon><FontIcon x:Name="EngineIndicator" Glyph="&#xE946;" Foreground="DarkOrange" /></NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.FooterMenuItems>
        <Grid x:Name="AppRoot">
        <Grid x:Name="Workspace" Padding="16,12,20,16" RowSpacing="12" AllowDrop="True" DragOver="OnDownloadDragOver" Drop="OnDownloadDrop">
            <Grid.KeyboardAccelerators>
                <KeyboardAccelerator Key="N" Modifiers="Control" Invoked="OnAddShortcut" />
                <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="OnSearchShortcut" />
                <KeyboardAccelerator Key="V" Modifiers="Control" Invoked="OnPasteDownloadShortcut" />
                <KeyboardAccelerator Key="Left" Modifiers="Menu" Invoked="OnDetailsBackShortcut" />
            </Grid.KeyboardAccelerators>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Spacing="8">
                <TextBlock x:Name="SectionTitle" Visibility="Collapsed" Text="All downloads" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <CommandBar x:Name="DownloadCommands" DefaultLabelPosition="Collapsed">
                    <AppBarButton Label="Add download" Icon="Add" Click="OnAddDownload" ToolTipService.ToolTip="Add download" />
                    <AppBarButton x:Name="StartAllButton" Label="Resume paused downloads" Icon="Play" Click="OnStartAll" ToolTipService.ToolTip="Resume paused downloads" />
                    <AppBarButton x:Name="PauseAllButton" Label="Pause all downloads" Icon="Pause" Click="OnPauseAll" ToolTipService.ToolTip="Pause all downloads" />
                    <CommandBar.Content><AutoSuggestBox x:Name="SearchBox" Width="260" PlaceholderText="Search downloads" QueryIcon="Find" TextChanged="OnSearchTextChanged" /></CommandBar.Content>
                    <CommandBar.SecondaryCommands>
                        <AppBarButton Label="Details" Icon="View" Click="OnSelectedDetails" />
                        <AppBarButton x:Name="ResumeSelectedButton" Label="Resume selected" Icon="Play" Click="OnResumeSelected" IsEnabled="False" />
                        <AppBarButton x:Name="PauseSelectedButton" Label="Pause selected" Icon="Pause" Click="OnPauseSelected" IsEnabled="False" />
                        <AppBarButton x:Name="RemoveSelectedButton" Label="Cancel or remove selected" Icon="Delete" Click="OnCancelOrRemoveSelected" IsEnabled="False" />
                        <AppBarButton x:Name="SelectedActionsButton" Label="More actions" Click="OnSelectedActions" IsEnabled="False" />
                        <AppBarButton Label="Paste download link" Icon="Paste" Click="OnPasteDownload" /><AppBarButton Label="Add torrent…" Icon="Add" Click="OnAddTorrent" /><AppBarButton Label="Refresh" Icon="Refresh" Click="OnRefresh" /><AppBarButton Label="Queue settings" Icon="Setting" Click="OnQueueSettings" /><AppBarButton Label="Delete user queue…" Icon="Delete" Click="OnDeleteQueue" />
                    </CommandBar.SecondaryCommands>
                </CommandBar>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="4">
                    <FontIcon Glyph="&#xE8CB;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                    <ComboBox x:Name="SortBox" SelectedIndex="0" SelectionChanged="OnSortChanged" MinWidth="90" AutomationProperties.Name="Sort downloads">
                        <ComboBoxItem Content="Order" Tag="order" /><ComboBoxItem Content="Status" Tag="state-asc" /><ComboBoxItem Content="Size" Tag="size-asc" />
                    </ComboBox>
                </StackPanel>
                </Grid>
                <TextBlock x:Name="SelectionSummary" Text="" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <InfoBar x:Name="MessageBar" IsOpen="False" Severity="Informational" AutomationProperties.LiveSetting="Polite" />
                <InfoBar x:Name="AssociationBar" IsOpen="False" Severity="Informational" Title="Torrent and magnet links" Message="Speed Download is registered as an available handler. Choose it in Windows Default apps to open these links and files here."><InfoBar.ActionButton><Button Content="Open Default apps" Click="OnOpenDefaultApps" /></InfoBar.ActionButton></InfoBar>
                <InfoBar x:Name="ConnectionBar" IsOpen="False" Severity="Warning" IsClosable="False" Title="Engine disconnected" Message="Displayed downloads may be out of date. Reconnect to resume managing downloads." AutomationProperties.LiveSetting="Polite">
                    <InfoBar.ActionButton><Button Content="Reconnect" Click="OnRefresh" /></InfoBar.ActionButton>
                </InfoBar>
            </StackPanel>
            <Grid Grid.Row="1" ColumnSpacing="14" SizeChanged="OnWorkspaceSizeChanged">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="DetailsColumn" Width="0"/></Grid.ColumnDefinitions>
                <ListView x:Name="JobsList" SelectionMode="Extended" KeyDown="OnJobsKeyDown" RightTapped="OnJobsRightTapped" AutomationProperties.Name="Downloads" SelectionChanged="OnJobSelectionChanged" IsItemClickEnabled="False">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:DownloadJob">
                            <Grid Padding="12" ColumnSpacing="12" MinHeight="72">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="160"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Grid VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="20" Visibility="{Binding FallbackIconVisibility}" AutomationProperties.AccessibilityView="Raw" />
                                    <Image Source="{Binding FileIcon}" Width="20" Height="20" AutomationProperties.AccessibilityView="Raw" />
                                </Grid>
                                <StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" Style="{ThemeResource SubtitleTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Host}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" FontSize="12" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding StateText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <ProgressBar AutomationProperties.Name="{Binding ProgressText}" Value="{Binding Progress}" Maximum="100" Visibility="{Binding ProgressVisibility}" />
                                    <TextBlock Text="{Binding ProgressText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="11" />
                                    <TextBlock Text="{Binding CompactMetrics}" Visibility="{Binding CompactMetricsVisibility}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="11" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <Button Content="{Binding PrimaryActionGlyph}" FontFamily="Segoe MDL2 Assets" AutomationProperties.Name="{Binding PrimaryActionText}" IsEnabled="{Binding CanControl}" Tag="{Binding JobId}" Visibility="{Binding PrimaryActionVisibility}" Click="OnJobAction" ToolTipService.ToolTip="Start, pause, resume, or retry" />
                                    <Button Content="ⓘ" AutomationProperties.Name="Show transfer details" Tag="{Binding JobId}" Click="OnShowDetails" ToolTipService.ToolTip="Show transfer details" />
                                    <Button Content="✕" AutomationProperties.Name="{Binding RemoveActionText}" IsEnabled="{Binding CanControl}" Tag="{Binding JobId}" Click="OnCancelOrRemove" ToolTipService.ToolTip="{Binding RemoveActionText}" />
                                    <Button Content="⋯" AutomationProperties.Name="More transfer actions" IsEnabled="{Binding CanControl}" Tag="{Binding JobId}" Click="OnMoreActions" ToolTipService.ToolTip="More actions" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Visibility="Collapsed">
                    <TextBlock x:Name="EmptyStateText" Text="No downloads yet" Style="{ThemeResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                    <Button x:Name="EmptyStateAction" Content="Add download" Click="OnEmptyStateAction" HorizontalAlignment="Center" />
                </StackPanel>
                <Border x:Name="DetailsPane" Grid.Column="1" Visibility="Collapsed" Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="5">
                            <StackPanel.Resources><Style TargetType="TextBlock"><Setter Property="FontSize" Value="11" /></Style></StackPanel.Resources>
                            <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Transfer details" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" /><Button x:Name="CloseDetailsButton" Grid.Column="1" Click="OnCloseDetails" ToolTipService.ToolTip="Close transfer details" AutomationProperties.Name="Close transfer details"><FontIcon Glyph="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="12" /></Button></Grid>
                            <TextBlock x:Name="DetailTitle" Text="Select a transfer" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="STATUS" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="DetailState" Text="—" />
                            <TextBlock Text="SOURCE HOST" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="DetailUrl" Text="—" TextWrapping="Wrap" IsTextSelectionEnabled="True" FlowDirection="LeftToRight" />
                            <TextBlock Text="DESTINATION" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="DetailDestination" Text="—" TextWrapping="Wrap" IsTextSelectionEnabled="True" FlowDirection="LeftToRight" />
                            <TextBlock x:Name="DetailProgress" Text="" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="DetailCheckpoint" Text="" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            <TextBlock x:Name="DetailRate" Text="" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="DetailQueue" Text="" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="DetailJobLimit" Text="" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="DetailReference" Text="" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="DetailChecksum" Text="" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="DetailError" Text="" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" />
                            <TextBlock x:Name="DetailRetry" Text="" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="DetailQueueAction" Text="" TextWrapping="Wrap" />
                            <TextBlock x:Name="TorrentHeading" Text="TORRENT" FontWeight="SemiBold" Visibility="Collapsed" Margin="0,8,0,0" />
                            <TextBlock x:Name="TorrentStats" Visibility="Collapsed" TextWrapping="Wrap" />
                            <TextBlock x:Name="WorkersHeading" Text="CONNECTIONS" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed" Margin="0,8,0,0" />
                            <ItemsControl x:Name="WorkerList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="local:DownloadWorker">
                                        <StackPanel Spacing="2" Margin="0,2,0,3">
                                            <Grid ColumnSpacing="4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Caption}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1" Text="{Binding RateText}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </Grid>
                                            <ProgressBar Value="{Binding Percent}" Maximum="100" Height="3" AutomationProperties.Name="{Binding Caption}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
            <Grid Grid.Row="2" ColumnSpacing="10" Height="30">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="ConnectionStatus" Grid.Column="1" Text="Starting local engine…" Visibility="Collapsed" />
                <TextBlock x:Name="AggregateSpeed" Grid.Column="2" HorizontalAlignment="Right" Margin="0,0,12,0" VerticalAlignment="Center" />
                <TextBlock x:Name="EffectiveLimit" Grid.Column="3" VerticalAlignment="Center" />
                <TextBlock Grid.Column="4" Text="Global limit" VerticalAlignment="Center" />
                <ComboBox x:Name="SpeedLimitBox" Grid.Column="5" Height="26" MinWidth="110" SelectionChanged="OnSpeedLimitChanged"><ComboBoxItem Content="Unlimited" Tag="0"/><ComboBoxItem Content="1 MB/s" Tag="1"/><ComboBoxItem Content="2 MB/s" Tag="2"/><ComboBoxItem Content="5 MB/s" Tag="5"/><ComboBoxItem Content="10 MB/s" Tag="10"/><ComboBoxItem Content="20 MB/s" Tag="20"/><ComboBoxItem Content="50 MB/s" Tag="50"/><ComboBoxItem Content="100 MB/s" Tag="100"/></ComboBox>
                <TextBlock x:Name="QueueSummary" Grid.Column="6" Text="0 active · 0 queued" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
            </Grid>
        </Grid>
        <ScrollViewer x:Name="SettingsView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="SettingsContent" Padding="16" Spacing="14" HorizontalAlignment="Stretch">
                <TextBlock Text="Settings" Style="{ThemeResource TitleTextBlockStyle}" />
                <InfoBar x:Name="SettingsMessage" IsOpen="False" Severity="Error" AutomationProperties.LiveSetting="Polite" />
                <ComboBox x:Name="SettingsSectionBox" Header="Go to settings section" SelectionChanged="OnSettingsSectionChanged" HorizontalAlignment="Left">
                    <ComboBoxItem Content="Appearance" Tag="appearance" /><ComboBoxItem Content="General" Tag="general" /><ComboBoxItem Content="Notifications" Tag="notifications" /><ComboBoxItem Content="Downloads" Tag="downloads" /><ComboBoxItem Content="Network" Tag="network" /><ComboBoxItem Content="Bandwidth" Tag="bandwidth" /><ComboBoxItem Content="Integration" Tag="integration" />
                </ComboBox>
                <TextBlock x:Name="AppearanceHeading" Text="Appearance" Style="{ThemeResource SubtitleTextBlockStyle}" />
                <ComboBox x:Name="AppearanceBox" Header="App theme" SelectionChanged="OnAppearanceChanged" HorizontalAlignment="Left">
                    <ComboBoxItem Content="System" Tag="Default"/><ComboBoxItem Content="Light" Tag="Light"/><ComboBoxItem Content="Dark" Tag="Dark"/>
                </ComboBox>
                <TextBlock x:Name="GeneralHeading" Text="General" Style="{ThemeResource SubtitleTextBlockStyle}" />
                <ComboBox x:Name="LanguageBox" Header="Language" SelectionChanged="OnLanguageChanged" HorizontalAlignment="Left">
                    <ComboBoxItem Content="System" Tag="system" /><ComboBoxItem Content="English" Tag="en" /><ComboBoxItem Content="فارسی" Tag="fa" />
                </ComboBox>
                <ToggleSwitch x:Name="LaunchOnLoginSwitch" Header="Open Speed Download at sign-in" Toggled="OnLoginSettingChanged" />
                <ToggleSwitch x:Name="StartMinimizedSwitch" Header="Start minimized at sign-in" Toggled="OnClientSettingChanged" />
                <ComboBox x:Name="CloseActionBox" Header="When closing the window" SelectionChanged="OnClientChoiceChanged" HorizontalAlignment="Left">
                    <ComboBoxItem Content="Continue in the notification area" Tag="hide" />
                    <ComboBoxItem Content="Exit the client" Tag="exit" />
                    <ComboBoxItem Content="Ask to stop the engine and quit" Tag="stop" />
                </ComboBox>
                <TextBlock Text="Downloads continue in the background when the client exits." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="NotificationsHeading" Text="Notifications" Style="{ThemeResource SubtitleTextBlockStyle}" />
                <ToggleSwitch x:Name="NotifyCompletedSwitch" Header="Completed downloads" Toggled="OnClientSettingChanged" />
                <ToggleSwitch x:Name="NotifyFailedSwitch" Header="Failed downloads" Toggled="OnClientSettingChanged" />
                <TextBlock x:Name="NotificationStatus" Text="Checking Windows notification availability…" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Button Content="Open Windows notification settings" Click="OnOpenNotificationSettings" HorizontalAlignment="Left" />
                <TextBlock Text="Notifications omit file names, paths, and links. They are sent while Speed Download is running. Windows may suppress them when the app runs as administrator." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <StackPanel Spacing="8"><TextBlock Text="Diagnostic logging"/><ToggleSwitch x:Name="DebugLoggingSwitch" Toggled="OnSettingToggled"/><TextBlock Text="Writes redacted engine activity to a bounded local log." Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock x:Name="DebugLogLocation" TextWrapping="Wrap" IsTextSelectionEnabled="True" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><Button Content="Open log folder" Click="OnOpenLogFolder" HorizontalAlignment="Left" /></StackPanel>
                <TextBlock x:Name="DownloadsHeading" Text="Downloads" Style="{ThemeResource SubtitleTextBlockStyle}" Margin="0,12,0,0" />
                <TextBox x:Name="DownloadFolderBox" Header="Default download folder" FlowDirection="LeftToRight" LostFocus="OnSettingLostFocus" />
                <Button Content="Choose default folder…" HorizontalAlignment="Left" Click="OnChooseDefaultFolder" />
                <NumberBox x:Name="ConcurrentBox" Header="Maximum simultaneous downloads" Minimum="1" Maximum="32" SpinButtonPlacementMode="Compact" ValueChanged="OnNumberSettingChanged" />
                <TextBlock x:Name="NetworkHeading" Text="Network" Style="{ThemeResource SubtitleTextBlockStyle}" Margin="0,12,0,0" />
                <NumberBox x:Name="ConnectionsBox" Header="Maximum connections per download" Minimum="1" Maximum="32" SpinButtonPlacementMode="Compact" ValueChanged="OnNumberSettingChanged" />
                <ComboBox x:Name="MultipartModeBox" Header="Parallel downloading" SelectionChanged="OnChoiceSettingChanged"><ComboBoxItem Content="Automatic" Tag="auto"/><ComboBoxItem Content="Fixed" Tag="fixed"/><ComboBoxItem Content="Off" Tag="off"/></ComboBox>
                <ComboBox x:Name="ProxyModeBox" Header="Proxy mode" SelectionChanged="OnChoiceSettingChanged"><ComboBoxItem Content="System" Tag="system"/><ComboBoxItem Content="Manual HTTP" Tag="custom"/><ComboBoxItem Content="Disabled" Tag="disabled"/></ComboBox>
                <TextBlock x:Name="ProxySystemNotice" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBox x:Name="ProxyUrlBox" Header="Manual HTTP proxy URL" PlaceholderText="http://proxy.example.com:8080" FlowDirection="LeftToRight" LostFocus="OnSettingLostFocus" />
                <TextBlock Text="Manual proxy authentication" FontWeight="SemiBold" />
                <TextBlock Text="Credentials are stored in Windows Credential Manager for this user. Authenticated HTTPS destinations are not supported yet; they fail without sending an unauthenticated request." TextWrapping="Wrap" />
                <TextBox x:Name="ProxyUserBox" Header="Username" />
                <PasswordBox x:Name="ProxyPasswordBox" Header="Password" />
                <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Save credentials" Click="OnSaveProxyCredentials" /><Button Content="Remove credentials" Click="OnRemoveProxyCredentials" /></StackPanel>
                <TextBlock x:Name="ProxyCredentialStatus" Text="Credential status unavailable" TextWrapping="Wrap" />
                <ToggleSwitch x:Name="ProxyAuthenticationSwitch" Header="Require authentication for manual proxy" Toggled="OnProxyAuthenticationToggled" />
                <TextBlock x:Name="BandwidthHeading" Text="Bandwidth" Style="{ThemeResource SubtitleTextBlockStyle}" Margin="0,12,0,0" />
                <NumberBox x:Name="BandwidthBox" Header="Global download limit (MB/s; 0 = unlimited)" Minimum="0" Maximum="100000" SpinButtonPlacementMode="Compact" ValueChanged="OnNumberSettingChanged" />
                <Button Content="Scheduled download limit…" Click="OnBandwidthSchedule" HorizontalAlignment="Left" />
                <TextBlock x:Name="IntegrationHeading" Text="Integration" Style="{ThemeResource SubtitleTextBlockStyle}" Margin="0,12,0,0" />
                <TextBlock Text="Register Speed Download as an available handler for torrent files and magnet links. Choose your default app in Windows Settings." TextWrapping="Wrap" />
                <Button Content="Register torrent and magnet handler" Click="OnRegisterAssociations" HorizontalAlignment="Left" />
                <Button Content="Open Windows default app settings" Click="OnOpenDefaultApps" HorizontalAlignment="Left" />
                <TextBox x:Name="BrowserExtensionsBox" Header="Browser capture file extensions" LostFocus="OnSettingLostFocus" />
                <TextBlock Text="Install the matching browser extension separately. Browser policies, authentication and site behavior may prevent interception." TextWrapping="Wrap" />
                <Button Content="Register browser integration" Click="OnRegisterBrowserIntegration" HorizontalAlignment="Left" />

            </StackPanel>
        </ScrollViewer>
        </Grid>
    </NavigationView>
    </Grid>
</Window>
